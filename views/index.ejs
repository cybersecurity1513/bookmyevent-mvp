<%- include("partials/header", { title, brand, currentUser, flash, csrfToken }) %>
<section class="hero">
  <div class="hero-copy">
    <p class="eyebrow">Meerut · Uttar Pradesh</p>
    <h1>Make every event worth remembering.</h1>
    <p>Discover event professionals, compare services and send an enquiry—all in one place.</p>
  </div>
  <form class="search-panel" action="/" method="get">
    <label>What are you looking for?
      <input type="search" name="q" value="<%= q %>" maxlength="80" placeholder="Photographer, catering...">
    </label>
    <label>City
      <input type="text" name="city" value="<%= city %>" maxlength="80" placeholder="Meerut">
    </label>
    <label>Category
      <select name="category">
        <option value="">All categories</option>
        <% categories.forEach((item) => { %><option value="<%= item %>" <%= category === item ? "selected" : "" %>><%= item %></option><% }) %>
      </select>
    </label>
    <button class="button button-primary" type="submit">Search vendors</button>
  </form>
</section>

<section class="section" id="vendors">
  <div class="section-heading">
    <div><p class="eyebrow">Explore local talent</p><h2>Find the right vendor</h2></div>
    <p class="muted"><%= vendors.length %> approved listing<%= vendors.length === 1 ? "" : "s" %></p>
  </div>
  <% if (vendors.length) { %>
    <div class="vendor-grid">
      <% vendors.forEach((vendor) => { %>
        <article class="vendor-card">
          <div class="vendor-card-top"><span class="category"><%= vendor.category %></span><span class="city"><%= vendor.city %></span></div>
          <h3><%= vendor.name %></h3>
          <p><%= vendor.description %></p>
          <div class="vendor-price">₹<%= Number(vendor.price).toLocaleString("en-IN") %> <small>starting price</small></div>
          <details class="enquiry">
            <summary class="button button-primary">Send an enquiry</summary>
            <form method="post" action="/vendors/<%= vendor.id %>/enquiries" class="stack-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <p class="privacy-note">Your contact details will be shared with this vendor so they can respond. Do not include sensitive information.</p>
              <label>Your name<input name="customer" required minlength="2" maxlength="100" autocomplete="name"></label>
              <label>Phone<input name="phone" required minlength="8" maxlength="20" inputmode="tel" autocomplete="tel" pattern="[0-9+() -]{8,20}"></label>
              <label>Event date<input name="event_date" type="date" required></label>
              <label>Event city<input name="city" required minlength="2" maxlength="80" value="Meerut"></label>
              <label>Budget (₹)<input name="budget" type="number" min="0" max="100000000" value="0"></label>
              <label>Event type
                <select name="event_type" required>
                  <option>Wedding</option><option>Birthday</option><option>Corporate</option><option>School / College</option><option>Other</option>
                </select>
              </label>
              <label>Requirements<textarea name="requirements" maxlength="1000" rows="3"></textarea></label>
              <button class="button button-primary" type="submit">Send enquiry</button>
            </form>
          </details>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state"><h3>No matching vendors yet</h3><p>Try a different city or category, or clear your search.</p><a class="button button-outline" href="/">Clear filters</a></div>
  <% } %>
</section>

<section class="section steps-section">
  <div class="section-heading"><div><p class="eyebrow">Simple planning</p><h2>Booking made easier</h2></div></div>
  <div class="steps">
    <article><span>01</span><h3>Discover</h3><p>Browse approved vendors by service and city.</p></article>
    <article><span>02</span><h3>Compare</h3><p>Review their services, starting price and description.</p></article>
    <article><span>03</span><h3>Connect</h3><p>Send an enquiry directly to the vendor.</p></article>
  </div>
</section>
<%- include("partials/footer") %>
