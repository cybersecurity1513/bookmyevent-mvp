<%- include("partials/header", { title, brand, currentUser, flash, csrfToken }) %>
<section class="narrow-section">
  <div class="form-card">
    <p class="eyebrow">Welcome back</p>
    <h1>Sign in</h1>
    <p class="muted">Vendor and administrator accounts are authenticated on the server.</p>
    <% if (error) { %><div class="notice notice-error" role="alert"><%= error %></div><% } %>
    <form method="post" action="/login" class="stack-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>Email<input name="email" type="email" required maxlength="254" autocomplete="username" value="<%= values?.email || '' %>"></label>
      <label>Password<input name="password" type="password" required minlength="12" maxlength="128" autocomplete="current-password"></label>
      <button class="button button-primary" type="submit">Sign in securely</button>
    </form>
    <p class="form-help">New vendor? <a href="/register">Create a vendor account</a>.</p>
  </div>
</section>
<%- include("partials/footer") %>
